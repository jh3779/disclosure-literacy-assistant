# --- 공시 리터러시 어시스턴트 (현재 프로젝트) ---

# DART OpenAPI — opendart.fss.or.kr, 개인회원 가입 후 즉시 무료 발급.
DART_API_KEY=...

# --- LLM (disclosure_lit/llm.py::complete — provider 스왑) ---
OPENAI_API_KEY=sk-...                 # LLM_PROVIDER=openai 일 때
# ANTHROPIC_API_KEY=sk-ant-...        # LLM_PROVIDER=anthropic 로 스왑할 때만
# GEMINI_API_KEY=...                  # LLM_PROVIDER=gemini 로 스왑할 때만 (aistudio.google.com/apikey, 무료)
LLM_PROVIDER=openai                   # openai | anthropic | gemini — 팀원마다 달라도 됨
MODEL_MINI=gpt-4o-mini                # claim 추출 / claim verification / guard
MODEL_FINAL=gpt-4o-mini               # 최종 답 (필요하면 상위 모델로 교체)

# 검색 관련성에 따른 기권 문턱. 비워 두면 점수 기반 기권은 비활성화된다.
# #130 실측상 정상/실패 사례 점수가 겹쳐 기본값을 확정하지 않았다.
# 모델과 검색 질의 형태가 바뀌면 재측정 필요: python -m disclosure_lit.eval.abstention
FACTCHECK_MIN_RELEVANCE_SCORE=

# --- 임베딩 (L1 검색 + 화법 클러스터링) ---
# 팀 결정 완료(PR #27 논의, 2026-09-11): local + dragonkue/BGE-m3-ko + 1024차원.
# 실측(RTX 4070 Laptop / Apple M5 Max MPS 양쪽) 기준 속도·자원 병목 없음, 한국어
# 파인튜닝 모델이라 클러스터 분리도·매칭 정확도도 후보 중 가장 나음(이슈 #29·#30).
# local 백엔드는 `uv sync --dev --extra local`로 sentence-transformers를 설치해야 한다.
EMBED_BACKEND=local                   # local | openai — 팀 결정: local
LOCAL_EMBED_MODEL=dragonkue/BGE-m3-ko # 한국어 파인튜닝 임베딩 모델
EMBED_DIM=1024                        # BGE-m3-ko 임베딩 차원
# EMBED_MODEL=text-embedding-3-small  # EMBED_BACKEND=openai 로 스왑할 때만 사용
